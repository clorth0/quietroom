[Unit]
Description=Quietroom RF monitoring node
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/quietroom-node --config /etc/quietroom/config.toml
User=quietroom
Group=quietroom
Restart=on-failure
RestartSec=10
# Exit 2 = invalid config or command line (listed in the journal): restarting
# cannot fix it. Fix the file (check with --check-config), then start again.
RestartPreventExitStatus=2
WatchdogSec=120
# On stop (SIGTERM) the node finishes the sweep in flight, flushes the alert and
# fleet outboxes once (a dead relay or central costs one timeout each) and
# closes its databases; past this, systemd kills it.
TimeoutStopSec=60
NotifyAccess=main
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/quietroom
StateDirectory=quietroom
ConfigurationDirectory=quietroom
MemoryMax=512M
CPUQuota=200%
Environment=PYTHONDONTWRITEBYTECODE=1
# Secrets (QUIETROOM_SMTP_PASSWORD, QUIETROOM_WEBHOOK_SECRET, ...) live here,
# never in config.toml. root:quietroom 0640. Optional ("-"): absent = no secrets.
EnvironmentFile=-/etc/quietroom/secrets.env

[Install]
WantedBy=multi-user.target
